# ==============================================================================
# OceanShield AI - Production Environment Configuration
# ==============================================================================

# Backend Public Address (Used by Next.js to proxy requests to FastAPI)
# Local Docker Compose: http://backend:8000
# Cloud PaaS (e.g. Render): https://oceanshield-backend.onrender.com
# Custom Domain / Reverse Proxy: https://api.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=http://backend:8000

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
PYTHONUNBUFFERED=1

# Frontend Server Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
